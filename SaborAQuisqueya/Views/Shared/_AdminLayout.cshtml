@{
    var nombreAdministrador = User.Identity?.Name ?? "Administrador";

    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var accion = ViewContext.RouteData.Values["action"]?.ToString();

    var inicial = !string.IsNullOrWhiteSpace(nombreAdministrador)
        ? nombreAdministrador.Substring(0, 1).ToUpper()
        : "A";
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] | Sabor a Quisqueya</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/gestion-sabor.css"
          asp-append-version="true" />

    <style>

        :root {
            --admin-vino: #4b0f17;
            --admin-vino-oscuro: #310b11;
            --admin-vino-claro: #84252b;
            --admin-dorado: #c99b52;
            --admin-dorado-claro: #e9c88d;
            --admin-fondo: #f5f6fa;
            --admin-blanco: #ffffff;
            --admin-texto: #243047;
            --admin-gris: #718096;
            --admin-borde: #e8e9ee;
            --admin-sidebar-ancho: 265px;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: var(--admin-fondo);
            color: var(--admin-texto);
            font-family: "Segoe UI", Arial, sans-serif;
        }

        /* =====================================
                   ESTRUCTURA GENERAL
                ===================================== */

        .admin-layout {
            display: flex;
            min-height: 100vh;
        }

        /* =====================================
                   MENÚ LATERAL
                ===================================== */

        .admin-sidebar {
            width: var(--admin-sidebar-ancho);
            background: linear-gradient( 180deg, var(--admin-vino) 0%, var(--admin-vino-oscuro) 100% );
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            display: flex;
            flex-direction: column;
            color: white;
            z-index: 1000;
        }

        /* LOGO */

        .admin-logo {
            padding: 27px 20px 23px;
            text-align: center;
            border-bottom: 1px solid rgba(255,255,255,.12);
        }

            .admin-logo img {
                width: 76px;
                height: 76px;
                object-fit: contain;
                border-radius: 50%;
                background: white;
                padding: 5px;
                margin-bottom: 11px;
            }

            .admin-logo h2 {
                font-size: 20px;
                font-weight: 700;
                color: white;
                margin: 0 0 5px;
            }

            .admin-logo p {
                color: var(--admin-dorado-claro);
                font-size: 10px;
                letter-spacing: 2px;
                font-weight: 700;
                margin: 0;
            }

        /* =====================================
                   NAVEGACIÓN
                ===================================== */

        .admin-menu {
            padding: 20px 13px;
            flex: 1;
            overflow-y: auto;
        }

        .admin-menu-titulo {
            font-size: 10px;
            color: #d0b1b3;
            letter-spacing: 1.6px;
            font-weight: 700;
            padding: 17px 14px 10px;
        }

        .admin-menu a {
            display: flex;
            align-items: center;
            gap: 13px;
            color: #f0e6e7;
            text-decoration: none;
            padding: 13px 15px;
            margin-bottom: 5px;
            border-radius: 9px;
            font-size: 14px;
            font-weight: 500;
            transition: background .2s ease, color .2s ease;
        }

            .admin-menu a:hover {
                background: rgba(255,255,255,.10);
                color: white;
            }

            .admin-menu a.activo {
                background: var(--admin-dorado);
                color: white;
                font-weight: 700;
            }

        .admin-menu .icono {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 23px;
            font-size: 17px;
            flex-shrink: 0;
        }

        /* MÓDULOS PENDIENTES */

        .admin-menu .modulo-pendiente {
            display: flex;
            align-items: center;
            gap: 13px;
            padding: 13px 15px;
            margin-bottom: 5px;
            color: #bca4a8;
            font-size: 14px;
            opacity: .7;
            cursor: default;
        }

            .admin-menu .modulo-pendiente .icono {
                width: 23px;
                text-align: center;
            }

        /* =====================================
                   CERRAR SESIÓN
                ===================================== */

        .admin-salir {
            padding: 20px 15px;
            border-top: 1px solid rgba(255,255,255,.12);
        }

            .admin-salir button {
                width: 100%;
                padding: 13px 16px;
                background: #a52b32;
                color: white;
                border: 1px solid rgba(255,255,255,.08);
                border-radius: 9px;
                font-size: 14px;
                font-weight: 700;
                cursor: pointer;
                transition: background .2s;
            }

                .admin-salir button:hover {
                    background: #c0343c;
                }

        /* =====================================
                   CONTENIDO PRINCIPAL
                ===================================== */

        .admin-main {
            margin-left: var(--admin-sidebar-ancho);
            width: calc(100% - var(--admin-sidebar-ancho));
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        /* =====================================
                   ENCABEZADO SUPERIOR
                ===================================== */

        .admin-header {
            background: white;
            padding: 19px 32px;
            border-bottom: 1px solid var(--admin-borde);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }

        .admin-header-izquierda h1 {
            margin: 0;
            font-size: 20px;
            font-weight: 700;
            color: var(--admin-vino);
        }

        .admin-header-subtitulo {
            font-size: 12px;
            color: var(--admin-gris);
            margin-top: 4px;
        }

        /* ADMINISTRADOR */

        .admin-usuario {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .admin-usuario-info {
            text-align: right;
        }

            .admin-usuario-info strong {
                display: block;
                font-size: 14px;
                font-weight: 700;
                color: var(--admin-texto);
            }

            .admin-usuario-info span {
                display: block;
                font-size: 12px;
                color: var(--admin-gris);
                margin-top: 2px;
            }

        .admin-avatar {
            height: 43px;
            width: 43px;
            border-radius: 50%;
            background: #f0e7e1;
            color: var(--admin-vino);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 18px;
        }

        /* =====================================
                   CONTENIDO DE LAS VISTAS
                ===================================== */

        .admin-contenido {
            flex: 1;
            width: 100%;
            padding: 30px 34px;
            min-width: 0;
        }

        /* =====================================
                   PIE DE PÁGINA
                ===================================== */

        .admin-footer {
            background: white;
            border-top: 1px solid var(--admin-borde);
            padding: 15px 20px;
            color: var(--admin-gris);
            font-size: 12px;
            text-align: center;
        }

        /* =====================================
                   RESPONSIVE
                ===================================== */

        @@media (max-width: 991px) {

            .admin-layout {
                display: block;
            }

            .admin-sidebar {
                position: relative;
                width: 100%;
                min-height: auto;
            }

            .admin-logo {
                padding: 17px;
            }

                .admin-logo img {
                    width: 60px;
                    height: 60px;
                }

            .admin-menu {
                display: flex;
                flex-wrap: wrap;
                gap: 5px;
                padding: 12px;
            }

            .admin-menu-titulo {
                width: 100%;
            }

            .admin-menu a {
                margin-bottom: 0;
            }

            .admin-menu .modulo-pendiente {
                display: none;
            }

            .admin-salir {
                padding: 12px;
            }

            .admin-main {
                margin-left: 0;
                width: 100%;
            }

            .admin-header {
                padding: 18px 22px;
            }

            .admin-contenido {
                padding: 22px;
            }
        }

        @@media (max-width: 576px) {

            .admin-logo h2 {
                font-size: 18px;
            }

            .admin-menu {
                gap: 4px;
            }

                .admin-menu a {
                    padding: 11px 12px;
                    font-size: 13px;
                }

            .admin-header {
                padding: 15px;
                flex-wrap: wrap;
            }

            .admin-header-izquierda h1 {
                font-size: 17px;
            }

            .admin-usuario {
                width: 100%;
                justify-content: flex-end;
            }

            .admin-contenido {
                padding: 15px;
            }
        }

    </style>

    @await RenderSectionAsync("Styles", required: false)

</head>

<body>

    <div class="admin-layout">

        <!-- MENÚ LATERAL -->

        <aside class="admin-sidebar">

            <!-- LOGO -->

            <div class="admin-logo">

                <img src="~/images/logo-sabor-quisqueya.jpg"
                     alt="Logo de Sabor a Quisqueya" />

                <h2>Sabor a Quisqueya</h2>

                <p>PANEL ADMINISTRATIVO</p>

            </div>

            <!-- NAVEGACIÓN -->

            <nav class="admin-menu">

                <div class="admin-menu-titulo">
                    PRINCIPAL
                </div>

                <!-- DASHBOARD -->

                <a asp-controller="Admin"
                   asp-action="Index"
                   class="@(controlador == "Admin" ? "activo" : "")">

                    <span class="icono">⌂</span>
                    <span>Dashboard</span>

                </a>

                <!-- RESERVACIONES -->

                <a asp-controller="Reservas"
                   asp-action="Administrar"
                   class="@(controlador == "Reservas" && accion == "Administrar" ? "activo" : "")">

                    <span class="icono">▦</span>
                    <span>Reservaciones</span>

                </a>

                <div class="admin-menu-titulo">
                    ADMINISTRACIÓN
                </div>

                <!-- MESAS: BOTÓN FUNCIONAL -->

                <a asp-controller="Mesas"
                   asp-action="Index"
                   class="@(controlador == "Mesas" ? "activo" : "")">

                    <span class="icono">▤</span>
                    <span>Mesas</span>

                </a>

                <!-- HORARIOS: PENDIENTE -->

                <div class="modulo-pendiente"
                     title="Módulo en desarrollo">

                    <span class="icono">◷</span>
                    <span>Horarios</span>

                </div>

                <!-- MENÚ: PENDIENTE -->

                <div class="modulo-pendiente"
                     title="Módulo en desarrollo">

                    <span class="icono">☷</span>
                    <span>Menú del restaurante</span>

                </div>

                <!-- USUARIOS -->

                <a asp-controller="Usuarios"
                   asp-action="Index"
                   class="@(controlador == "Usuarios" && accion == "Index" ? "activo" : "")">

                    <span class="icono">♟</span>
                    <span>Usuarios</span>

                </a>

            </nav>

            <!-- CERRAR SESIÓN -->

            <div class="admin-salir">

                <form asp-controller="Usuarios"
                      asp-action="Logout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit">
                        ↪ &nbsp; Cerrar sesión
                    </button>

                </form>

            </div>

        </aside>

        <!-- ÁREA PRINCIPAL -->

        <div class="admin-main">

            <!-- ENCABEZADO SUPERIOR -->

            <header class="admin-header">

                <div class="admin-header-izquierda">

                    <h1>
                        Administración del Restaurante
                    </h1>

                    <div class="admin-header-subtitulo">
                        Sistema de Gestión de Reservaciones
                    </div>

                </div>

                <!-- ADMINISTRADOR CONECTADO -->

                <div class="admin-usuario">

                    <div class="admin-usuario-info">

                        <strong>
                            @nombreAdministrador
                        </strong>

                        <span>
                            Administrador
                        </span>

                    </div>

                    <div class="admin-avatar">
                        @inicial
                    </div>

                </div>

            </header>

            <!-- CONTENIDO DE CADA VISTA -->

            <main class="admin-contenido">

                @RenderBody()

            </main>

            <!-- PIE DE PÁGINA -->

            <footer class="admin-footer">

                © @DateTime.Now.Year - Sabor a Quisqueya |
                Sistema de Gestión de Reservaciones

            </footer>

        </div>

    </div>

    <!-- JAVASCRIPT -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>