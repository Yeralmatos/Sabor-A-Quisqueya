@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_AuthLayout";
}

<div class="auth-shell">

    <!-- FORMULARIO DE INICIO DE SESIÓN -->
    <section class="auth-card">

        <!-- LOGO -->
        <div class="auth-brand">

            <img src="~/images/logo-sabor-quisqueya.jpg"
                 alt="Logo de Sabor a Quisqueya" />

            <span>Sabor a Quisqueya</span>

        </div>

        <!-- PRESENTACIÓN -->
        <p class="eyebrow">
            BIENVENIDO DE NUEVO
        </p>

        <h1>¡Qué bueno verte!</h1>

        <p class="muted">
            Inicia sesión para gestionar tus reservaciones.
        </p>

        <!-- MENSAJE DE CONFIRMACIÓN -->
        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success auth-message">
                @TempData["Mensaje"]
            </div>
        }

        <!-- MENSAJES DE ERROR -->
        <div asp-validation-summary="All"
             class="validation">
        </div>

        <!-- FORMULARIO -->
        <form asp-controller="Usuarios"
              asp-action="Login"
              method="post"
              class="form-stack">

            @Html.AntiForgeryToken()

            <!-- CONSERVAR DESTINO DESPUÉS DEL LOGIN -->
            <input type="hidden"
                   name="returnUrl"
                   value="@ViewData["ReturnUrl"]" />

            <!-- CORREO -->
            <label>
                Correo electrónico

                <input name="correo"
                       type="email"
                       class="form-control"
                       required
                       maxlength="150"
                       autocomplete="email"
                       placeholder="tu@correo.com" />
            </label>

            <!-- CONTRASEÑA -->
            <label>
                Contraseña

                <input name="contrasena"
                       type="password"
                       class="form-control"
                       required
                       autocomplete="current-password"
                       placeholder="Tu contraseña" />
            </label>

            <!-- BOTÓN -->
            <button class="btn-sq" type="submit">
                Iniciar sesión <span>→</span>
            </button>

        </form>

        <p class="auth-footer">
            <a asp-controller="Usuarios" asp-action="RecuperarContrasena">Olvidé mi contraseña</a>
        </p>

        <!-- REGISTRO -->
        <p class="auth-footer">
            ¿No tienes cuenta?
            <a asp-controller="Usuarios"
               asp-action="Registro">
                Regístrate aquí
            </a>
        </p>

    </section>

    <!-- PANEL VISUAL -->
    <aside class="auth-art">

        <img class="auth-logo"
             src="~/images/logo-sabor-quisqueya.jpg"
             alt="Sabor a Quisqueya" />

        <div class="auth-art-copy">

            <h2>
                El sabor de casa<br />
                te está esperando.
            </h2>

            <p>
                Tradición dominicana en cada encuentro.
            </p>

        </div>

    </aside>

</div>
